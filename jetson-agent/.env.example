# MAVLink connection. Confirm the port, baud rate, and system id for your wiring.
MAVLINK_CONNECTION=/dev/ttyUSB0
MAVLINK_BAUD=57600
MAVLINK_TARGET_SYSID=1
MAVLINK_SOURCE_SYSTEM=254
MAVLINK_SOURCE_COMPONENT=191
HEARTBEAT_TIMEOUT=10

# Workstation backend
BACKEND_URL=http://192.168.1.10:5000
API_KEY=replace-with-the-same-random-secret-as-the-backend
AIRCRAFT_ID=1
HTTP_TIMEOUT=15

# Local storage
DATA_DIR=./data
KEEP_LOCAL_LOGS=false

# Collection behaviour
TELEMETRY_HZ=2
TELEMETRY_BATCH_SECONDS=5
TELEMETRY_BATCH_MAX=500
MISSION_SYNC_INTERVAL=20
RESYNC_ON_ARM=true
POST_DISARM_DELAY=10
MIN_LOG_BYTES=4096
LOG_MAX_ATTEMPTS=10
